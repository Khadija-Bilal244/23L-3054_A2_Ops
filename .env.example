# Copy to .env and fill in. NEVER commit .env
ROLL_NUMBER=00000000          # used in names: <ROLL_NUMBER>_A2_Ops

# --- DagsHub / MLflow (training machine only) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<ROLL_NUMBER>_A2_Ops.mlflow
DAGSHUB_USER=<your-dagshub-username>
DAGSHUB_TOKEN=<your-dagshub-access-token>

# --- Database (docker compose) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visionguard

# --- Flask web app ---
SECRET_KEY=change-me
MODEL_PATH=/models/champion/model.keras
THRESHOLD_PATH=/models/champion/threshold.json
MODEL_NAME=visionguard
MODEL_VERSION=1
MAX_UPLOAD_MB=5
PORT=5000

# --- Task 7/8: remote inference API (leave INFERENCE_URL empty to run the model locally) ---
INFERENCE_URL=
INFERENCE_API_KEY=change-me-long-random-string
API_KEY=change-me-long-random-string   # same value, set on the API server side
